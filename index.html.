      els.eventNotesInput.value = event.notes || "";
    } else {
      els.eventModalTitle.textContent = "Nouvel événement";
    }

    els.eventModal.classList.add("open");
    els.eventModal.setAttribute("aria-hidden", "false");
    setTimeout(() => els.eventNameInput.focus(), 50);
  }

  function closeEventModal() {
    els.eventModal.classList.remove("open");
    els.eventModal.setAttribute("aria-hidden", "true");
  }

  function saveEvent(e) {
    e.preventDefault();

    const type = document.querySelector('input[name="eventType"]:checked').value;
    const name = els.eventNameInput.value.trim();
    const amount = Math.abs(Number(els.eventAmountInput.value));
    const date = els.eventDateInput.value;
    const endDate = els.eventEndDateInput.value;
    const recurrence = els.eventRecurrenceInput.value;

    if (!name || !Number.isFinite(amount) || amount <= 0 || !isValidDateString(date)) {
      showToast("Vérifiez le libellé, le montant et la date.", true);
      return;
    }

    if (endDate && parseISODate(endDate) < parseISODate(date)) {
      showToast("La date de fin doit être postérieure à la date de départ.", true);
      return;
    }

    const payload = {
      id: els.eventIdInput.value || generateId(),
      name,
      type,
      amount,
      date,
      endDate: recurrence === "none" ? "" : endDate,
      category: els.eventCategoryInput.value,
      status: els.eventStatusInput.value,
      recurrence,
      notes: els.eventNotesInput.value.trim(),
      createdAt: new Date().toISOString()
    };

    const existingIndex = state.events.findIndex(event => event.id === payload.id);
    if (existingIndex >= 0) {
      payload.createdAt = state.events[existingIndex].createdAt;
      state.events[existingIndex] = payload;
    } else {
      state.events.push(payload);
    }

    persist();
    closeEventModal();
    renderAll();
    showToast(existingIndex >= 0 ? "Événement mis à jour." : "Événement ajouté.");
  }

  function deleteEvent(id) {
    const event = state.events.find(item => item.id === id);
    if (!event) return;

    const confirmed = window.confirm(`Supprimer « ${event.name} » ?`);
    if (!confirmed) return;

    state.events = state.events.filter(item => item.id !== id);
    persist();
    renderAll();
    showToast("Événement supprimé.");
  }

  function populateCategoryOptions(type, selected = "") {
    els.eventCategoryInput.innerHTML = categories[type]
      .map(category => `<option value="${escapeHtml(category)}">${escapeHtml(category)}</option>`)
      .join("");

    if (selected && categories[type].includes(selected)) {
      els.eventCategoryInput.value = selected;
    }
  }

  function saveSettings(e) {
    e.preventDefault();

    const openingBalance = Number(els.openingBalanceInput.value);
    const alertThreshold = Number(els.alertThresholdInput.value);

    if (!Number.isFinite(openingBalance) || !Number.isFinite(alertThreshold)) {
      showToast("Les montants des paramètres sont invalides.", true);
      return;
    }

    state.settings.openingBalance = openingBalance;
    state.settings.alertThreshold = alertThreshold;
    state.settings.currency = els.currencyInput.value;
    persist();
    renderAll();
    showToast("Paramètres enregistrés.");
  }

  function syncSettingsForm() {
    els.openingBalanceInput.value = state.settings.openingBalance;
    els.alertThresholdInput.value = state.settings.alertThreshold;
    els.currencyInput.value = state.settings.currency;
    els.currencySuffix.textContent = currencySymbol();
  }

  function loadDemoData() {
    const today = startOfDay(new Date());

    state = {
      settings: {
        openingBalance: 4800000,
        alertThreshold: 1000000,
        currency: "MGA",
        forecastDays: 90
      },
      events: [
        makeDemoEvent("Paiement client Atlas", "income", 3200000, addDays(today, 5), "Paiements clients", "confirmed"),
        makeDemoEvent("Loyer du bureau", "expense", 1200000, addDays(today, 2), "Loyer", "confirmed", "monthly", addMonths(today, 6)),
        makeDemoEvent("Salaires équipe", "expense", 2100000, addDays(today, 12), "Salaires", "planned", "monthly", addMonths(today, 6)),
        makeDemoEvent("Contrat maintenance", "income", 850000, addDays(today, 9), "Ventes", "planned", "monthly", addMonths(today, 5)),
        makeDemoEvent("Abonnement logiciel", "expense", 180000, addDays(today, 4), "Abonnements", "confirmed", "monthly", addMonths(today, 6)),
        makeDemoEvent("TVA à décaisser", "expense", 640000, addDays(today, 24), "TVA", "planned", "quarterly", addMonths(today, 9)),
        makeDemoEvent("Achat matériel", "expense", 1750000, addDays(today, 35), "Achats", "planned"),
        makeDemoEvent("Paiement client Nova", "income", 2700000, addDays(today, 28), "Paiements clients", "planned")
      ],
      feasibility: state.feasibility || structuredClone(defaultState.feasibility)
    };

    persist();
    renderAll();
    showToast("Données de démonstration chargées.");
  }

  function makeDemoEvent(name, type, amount, date, category, status, recurrence = "none", endDate = null) {
    return {
      id: generateId(),
      name,
      type,
      amount,
      date: toISODate(date),
      endDate: endDate ? toISODate(endDate) : "",
      category,
      status,
      recurrence,
      notes: "",
      createdAt: new Date().toISOString()
    };
  }

  function exportData() {
    const blob = new Blob([JSON.stringify(state, null, 2)], { type: "application/json" });
    const url = URL.createObjectURL(blob);
    const anchor = document.createElement("a");
    anchor.href = url;
    anchor.download = `okane-flow-${toISODate(new Date())}.json`;
    document.body.appendChild(anchor);
    anchor.click();
    anchor.remove();
    URL.revokeObjectURL(url);
    showToast("Export JSON généré.");
  }

  function importData(e) {
    const file = e.target.files?.[0];
    if (!file) return;

    const reader = new FileReader();
    reader.onload = () => {
      try {
        const imported = JSON.parse(reader.result);
        state = sanitizeState(imported);
        persist();
        renderAll();
        showToast("Données importées avec succès.");
      } catch {
        showToast("Le fichier JSON est invalide.", true);
      } finally {
        els.importInput.value = "";
      }
    };
    reader.readAsText(file);
  }

  function clearData() {
    const confirmed = window.confirm("Effacer définitivement tous les événements et paramètres ?");
    if (!confirmed) return;

    state = structuredClone(defaultState);
    persist();
    renderAll();
    showToast("Toutes les données ont été effacées.");
  }

  function switchView(viewName) {
    els.navItems.forEach(item => item.classList.toggle("active", item.dataset.view === viewName));
    els.views.forEach(view => view.classList.toggle("active", view.id === `${viewName}View`));
    els.pageEyebrow.textContent = pageMeta[viewName][0];
    els.pageTitle.textContent = pageMeta[viewName][1];
    els.sidebar.classList.remove("open");

    if (viewName === "dashboard" && chart) {
      setTimeout(() => chart.resize(), 50);
    }
  }

  function setDefaultEventDate() {
    els.eventDateInput.value = toISODate(new Date());
  }

  function showToast(message, isError = false) {
    const toast = document.createElement("div");
    toast.className = `toast${isError ? " error" : ""}`;
    toast.textContent = message;
    els.toastContainer.appendChild(toast);
    setTimeout(() => toast.remove(), 3200);
  }

  function formatMoney(value) {
    const currency = state.settings.currency;
    const options = {
      maximumFractionDigits: currency === "MGA" ? 0 : 2,
      minimumFractionDigits: 0
    };

    if (currency === "MGA") {
      return `${new Intl.NumberFormat("fr-FR", options).format(value)} Ar`;
    }

    return new Intl.NumberFormat("fr-FR", {
      style: "currency",
      currency,
      ...options
    }).format(value);
  }

  function compactMoney(value) {
    const abs = Math.abs(value);
    const symbol = currencySymbol();
    let formatted;

    if (abs >= 1_000_000_000) formatted = `${(value / 1_000_000_000).toFixed(1)} Md`;
    else if (abs >= 1_000_000) formatted = `${(value / 1_000_000).toFixed(1)} M`;
    else if (abs >= 1_000) formatted = `${(value / 1_000).toFixed(0)} k`;
    else formatted = Math.round(value).toString();

    return `${formatted} ${symbol}`;
  }

  function currencySymbol() {
    return { MGA: "Ar", EUR: "€", USD: "$" }[state.settings.currency] || "Ar";
  }

  function formatDate(date) {
    return new Intl.DateTimeFormat("fr-FR", {
      day: "2-digit",
      month: "short",
      year: "numeric"
    }).format(date);
  }

  function parseISODate(value) {
    const [year, month, day] = value.split("-").map(Number);
    return new Date(year, month - 1, day);
  }

  function toISODate(date) {
    const year = date.getFullYear();
    const month = String(date.getMonth() + 1).padStart(2, "0");
    const day = String(date.getDate()).padStart(2, "0");
    return `${year}-${month}-${day}`;
  }

  function isValidDateString(value) {
    return /^\d{4}-\d{2}-\d{2}$/.test(value) && !Number.isNaN(parseISODate(value).getTime());
  }

  function startOfDay(date) {
    return new Date(date.getFullYear(), date.getMonth(), date.getDate());
  }

  function startOfMonth(date) {
    return new Date(date.getFullYear(), date.getMonth(), 1);
  }

  function endOfMonth(date) {
    return new Date(date.getFullYear(), date.getMonth() + 1, 0);
  }

  function addDays(date, days) {
    const result = new Date(date);
    result.setDate(result.getDate() + days);
    return startOfDay(result);
  }

  function addMonths(date, months) {
    return new Date(date.getFullYear(), date.getMonth() + months, 1);
  }

  function addMonthsPreserveDay(date, months) {
    const targetMonth = date.getMonth() + months;
    const targetYear = date.getFullYear() + Math.floor(targetMonth / 12);
    const normalizedMonth = ((targetMonth % 12) + 12) % 12;
    const lastDay = new Date(targetYear, normalizedMonth + 1, 0).getDate();
    return new Date(targetYear, normalizedMonth, Math.min(date.getDate(), lastDay));
  }

  function addYearsPreserveDay(date, years) {
    const year = date.getFullYear() + years;
    const month = date.getMonth();
    const lastDay = new Date(year, month + 1, 0).getDate();
    return new Date(year, month, Math.min(date.getDate(), lastDay));
  }

  function startOfWeekMonday(date) {
    const day = date.getDay() || 7;
    return addDays(date, 1 - day);
  }

  function endOfWeekSunday(date) {
    const day = date.getDay() || 7;
    return addDays(date, 7 - day);
  }

  function finiteNumber(value, fallback) {
    const number = Number(value);
    return Number.isFinite(number) ? number : fallback;
  }

  function generateId() {
    if (crypto?.randomUUID) return crypto.randomUUID();
    return `evt-${Date.now()}-${Math.random().toString(16).slice(2)}`;
  }

  function escapeHtml(value) {
    return String(value)
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");
  }
})();

