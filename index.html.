  function renderCalendar() {
    const monthStart = startOfMonth(currentCalendarDate);
    const gridStart = startOfWeekMonday(monthStart);
    const monthEnd = endOfMonth(monthStart);
    const gridEnd = endOfWeekSunday(monthEnd);
    const occurrences = expandOccurrences(gridStart, gridEnd);
    const byDate = new Map();

    occurrences.forEach(event => {
      const key = toISODate(event.date);
      if (!byDate.has(key)) byDate.set(key, []);
      byDate.get(key).push(event);
    });

    els.calendarMonthLabel.textContent = new Intl.DateTimeFormat("fr-FR", {
      month: "long",
      year: "numeric"
    }).format(monthStart);

    const days = [];
    let cursor = new Date(gridStart);

    while (cursor <= gridEnd) {
      const key = toISODate(cursor);
      const dayEvents = byDate.get(key) || [];
      const isCurrentMonth = cursor.getMonth() === monthStart.getMonth();
      const isToday = key === toISODate(new Date());

      days.push(`
        <div class="calendar-day ${isCurrentMonth ? "" : "muted"} ${isToday ? "today" : ""}">
          <div class="calendar-day-number">${cursor.getDate()}</div>
          ${dayEvents.slice(0, 4).map(event => `
            <div class="calendar-event ${event.type}" title="${escapeHtml(event.name)} · ${formatMoney(event.amount)}">
              ${escapeHtml(event.name)}
            </div>
          `).join("")}
          ${dayEvents.length > 4 ? `<div class="calendar-event">+${dayEvents.length - 4} autres</div>` : ""}
        </div>
      `);

      cursor = addDays(cursor, 1);
    }

    els.calendarGrid.innerHTML = days.join("");
  }


