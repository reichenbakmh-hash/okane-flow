  function calculateFeasibility() {
    const f = state.feasibility;
    const directCosts = f.costs.reduce((sum, row) => sum + nonNegativeNumber(row.amount), 0);
    const contingency = directCosts * (f.contingencyRate / 100);
    const totalNeed = directCosts + contingency + f.workingCapital;
    const listedFunding = f.funding.reduce((sum, row) => sum + nonNegativeNumber(row.amount), 0);
    const immediateResources = listedFunding + f.currentSavings;
    const fundingGap = Math.max(0, totalNeed - immediateResources);
    const monthlyCapacityFromBudget = Math.max(0, f.monthlyIncome - f.monthlyExpenses);
    const monthlySavings = Math.max(monthlyCapacityFromBudget, f.manualMonthlySavings);
    const monthsToTarget = fundingGap <= 0 ? 0 : monthlySavings > 0 ? Math.ceil(fundingGap / monthlySavings) : null;
    const targetDate = monthsToTarget === null ? null : addMonthsPreserveDay(startOfDay(new Date()), monthsToTarget);
    const operatingSurplus = f.projectMonthlyRevenue - f.projectMonthlyOperatingCosts;
    const paybackMonths = totalNeed > 0 && operatingSurplus > 0 ? Math.ceil(totalNeed / operatingSurplus) : null;
    const coverageRate = totalNeed > 0 ? immediateResources / totalNeed : 0;
    const debtFunding = f.funding
      .filter(row => ["Emprunt", "Crédit fournisseur"].includes(row.type))
      .reduce((sum, row) => sum + row.amount, 0);
    const debtShare = immediateResources > 0 ? debtFunding / immediateResources : 0;

    return {
      directCosts,
      contingency,
      totalNeed,
      listedFunding,
      immediateResources,
      fundingGap,
      monthlyCapacityFromBudget,
      monthlySavings,
      monthsToTarget,
      targetDate,
      operatingSurplus,
      paybackMonths,
      coverageRate,
      debtFunding,
      debtShare
    };
  }

  function renderFeasibility() {
    const f = state.feasibility;
    const r = calculateFeasibility();

    els.totalProjectNeedResult.textContent = formatMoney(r.totalNeed);
    els.immediateResourcesResult.textContent = formatMoney(r.immediateResources);
    els.fundingGapResult.textContent = formatMoney(r.fundingGap);
    els.monthlySavingsResult.textContent = formatMoney(r.monthlySavings);
    els.monthsToTargetResult.textContent = r.monthsToTarget === null
      ? "Non calculable"
      : r.monthsToTarget === 0
        ? "Budget disponible"
        : `${r.monthsToTarget} mois`;
    els.targetDateHint.textContent = r.targetDate
      ? `Budget estimé vers ${formatDate(r.targetDate)}`
      : "Aucune capacité d’épargne positive";
    els.paybackResult.textContent = r.paybackMonths
      ? `${r.paybackMonths} mois`
      : r.operatingSurplus === 0
        ? "Non renseigné"
        : "Non récupérable";

    let statusClass = "warning";
    let statusTitle = "Analyse partielle";
    let statusText = "Renseignez au moins un coût positif pour obtenir une conclusion exploitable.";

    if (r.totalNeed > 0) {
      if (r.fundingGap <= 0) {
        statusClass = "good";
        statusTitle = "Financement initial couvert";
        statusText = `Les ressources immédiates couvrent le budget estimé avec une marge de ${formatMoney(r.immediateResources - r.totalNeed)}.`;
      } else if (r.monthsToTarget !== null) {
        const desiredDate = f.desiredStartDate ? parseISODate(f.desiredStartDate) : null;
        const onTime = desiredDate && r.targetDate ? r.targetDate <= desiredDate : null;
        statusClass = onTime === false ? "danger" : "warning";
        statusTitle = onTime === false ? "Budget insuffisant à la date souhaitée" : "Projet finançable progressivement";
        statusText = `Il reste ${formatMoney(r.fundingGap)} à réunir. Au rythme retenu, le budget serait atteint en environ ${r.monthsToTarget} mois.`;
      } else {
        statusClass = "danger";
        statusTitle = "Plan de financement incomplet";
        statusText = `Il manque ${formatMoney(r.fundingGap)} et aucune capacité d’épargne mensuelle positive n’est disponible.`;
      }
    }

    els.feasibilityStatus.className = `feasibility-status ${statusClass}`;
    els.feasibilityStatus.innerHTML = `<h3>${escapeHtml(statusTitle)}</h3><p>${escapeHtml(statusText)}</p>`;

    const analysis = [];
    if (r.totalNeed > 0) {
      analysis.push({
        title: "Structure des besoins",
        text: `Les coûts directs représentent ${percentage(r.directCosts, r.totalNeed)} du budget. La réserve de sécurité vaut ${formatMoney(r.contingency)} et le besoin de trésorerie initial ${formatMoney(f.workingCapital)}.`
      });

      analysis.push({
        title: "Couverture immédiate",
        text: `Les ressources disponibles couvrent ${Math.round(r.coverageRate * 100)} % du besoin total.${r.debtFunding > 0 ? ` La part des financements assimilés à de la dette représente ${Math.round(r.debtShare * 100)} % des ressources immédiates.` : ""}`
      });

      if (r.monthlySavings > 0) {
        analysis.push({
          title: "Effort d’épargne",
          text: `La capacité mensuelle retenue est de ${formatMoney(r.monthlySavings)}. Elle correspond au maximum entre l’épargne déclarée et le revenu disponible après dépenses.`
        });
      }

      if (f.desiredStartDate && r.targetDate) {
        const desired = parseISODate(f.desiredStartDate);
        const deltaMonths = monthDifference(r.targetDate, desired);
        analysis.push({
          title: "Compatibilité avec la date souhaitée",
          text: r.targetDate <= desired
            ? `Le budget devrait être réuni avant la date souhaitée, avec environ ${Math.abs(deltaMonths)} mois de marge.`
            : `Le budget serait réuni environ ${Math.abs(deltaMonths)} mois après la date souhaitée. Il faut réduire les coûts, augmenter l’apport ou reporter le lancement.`
        });
      }

      if (f.projectMonthlyRevenue > 0 || f.projectMonthlyOperatingCosts > 0) {
        analysis.push({
          title: "Exploitation simplifiée",
          text: r.operatingSurplus > 0
            ? `Le surplus mensuel estimé est de ${formatMoney(r.operatingSurplus)}. Le délai de récupération simple est d’environ ${r.paybackMonths} mois.`
            : `Les décaissements mensuels atteignent ou dépassent les encaissements. Le projet ne génère pas de surplus mensuel dans ces hypothèses.`
        });
      }
    }

    els.feasibilityAnalysis.innerHTML = analysis.length
      ? analysis.map(item => `<div class="analysis-item"><strong>${escapeHtml(item.title)}</strong><p>${escapeHtml(item.text)}</p></div>`).join("")
      : `<div class="analysis-item"><strong>Données insuffisantes</strong><p>Ajoutez les coûts réels du projet et les ressources envisagées.</p></div>`;

    const categoryTotals = new Map();
    f.costs.forEach(row => categoryTotals.set(row.category, (categoryTotals.get(row.category) || 0) + row.amount));
    const breakdown = Array.from(categoryTotals.entries()).filter(([, amount]) => amount > 0);

    els.projectCostBreakdown.innerHTML = [
      ...breakdown.map(([name, amount]) => `<tr><td>${escapeHtml(name)}</td><td class="align-right">${formatMoney(amount)}</td></tr>`),
      `<tr><td>Marge de sécurité (${f.contingencyRate} %)</td><td class="align-right">${formatMoney(r.contingency)}</td></tr>`,
      `<tr><td>Trésorerie initiale / BFR</td><td class="align-right">${formatMoney(f.workingCapital)}</td></tr>`,
      `<tr><td><strong>Total</strong></td><td class="align-right"><strong>${formatMoney(r.totalNeed)}</strong></td></tr>`
    ].join("");
  }

