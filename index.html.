    const max = Math.max(...items.map(item => item.amount));
    els.categoryBreakdown.innerHTML = items.map(item => `
      <div class="category-item">
        <p>${escapeHtml(item.category)} · ${item.type === "income" ? "Encaissement" : "Décaissement"}</p>
