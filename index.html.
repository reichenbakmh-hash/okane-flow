  function renderCategoryBreakdown() {
    const start = startOfDay(new Date());
    const end = addDays(start, state.settings.forecastDays - 1);
    const occurrences = expandOccurrences(start, end);
    const totals = new Map();

    occurrences.forEach(event => {
      const key = `${event.type}|${event.category}`;
      totals.set(key, (totals.get(key) || 0) + event.amount);
    });

    const items = Array.from(totals.entries())
      .map(([key, amount]) => {
        const [type, category] = key.split("|");
        return { type, category, amount };
      })
      .sort((a, b) => b.amount - a.amount)
      .slice(0, 6);

    if (!items.length) {
      els.categoryBreakdown.innerHTML = `
