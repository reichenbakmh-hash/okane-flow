  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
  <script>
(() => {
  "use strict";

  const STORAGE_KEY = "okaneFlowDataV1";

  const defaultState = {
    settings: {
      openingBalance: 1500000,
      alertThreshold: 300000,
      currency: "MGA",
      forecastDays: 90
    },
    events: [],
    feasibility: {
      projectName: "",
      profile: "personal",
      desiredStartDate: "",
      costs: [
        { id: "cost-default-1", name: "Équipement ou investissement initial", category: "Investissement", timing: "Démarrage", amount: 0 }
      ],
      funding: [
        { id: "fund-default-1", name: "Apport personnel", type: "Apport", amount: 0 }
      ],
      workingCapital: 0,
      contingencyRate: 10,
      monthlyIncome: 0,
      monthlyExpenses: 0,
      manualMonthlySavings: 0,
      currentSavings: 0,
      projectMonthlyRevenue: 0,
      projectMonthlyOperatingCosts: 0
    }
  };

  const categories = {
    income: [
      "Ventes",
      "Paiements clients",
      "Salaire",
      "Apport",
      "Emprunt",
      "Remboursement",
      "Autres encaissements"
    ],
    expense: [
      "Achats",
      "Fournisseurs",
      "Loyer",
      "Salaires",
      "Impôts et taxes",
      "TVA",
      "Abonnements",
      "Transport",
      "Énergie",
      "Autres décaissements"
    ]
  };

  const recurrenceLabels = {
    none: "Unique",
    weekly: "Hebdomadaire",
    monthly: "Mensuelle",
    quarterly: "Trimestrielle",
    yearly: "Annuelle"
  };

  const statusLabels = {
    planned: "Prévu",
    confirmed: "Confirmé",
    paid: "Réalisé"
  };

  const pageMeta = {
    dashboard: ["Vue générale", "Tableau de bord"],
    transactions: ["Gestion des flux", "Événements"],
    calendar: ["Chronologie", "Calendrier"],
    feasibility: ["Décision financière", "Étude de faisabilité"],
    settings: ["Configuration", "Paramètres"]
  };

  let state = loadState();
  let chart = null;
  let currentCalendarDate = startOfMonth(new Date());

  const els = {};

  document.addEventListener("DOMContentLoaded", init);

  function init() {
    cacheElements();
    bindEvents();
    syncSettingsForm();
    setDefaultEventDate();
    populateCategoryOptions("income");
    renderAll();
    initPWA();
  }


  let deferredInstallPrompt = null;

  function initPWA() {
    if ("serviceWorker" in navigator) {
      window.addEventListener("load", () => {
        navigator.serviceWorker.register("./service-worker.js").catch(error => {
          console.error("Échec d’enregistrement du service worker :", error);
        });
      });
    }

    window.addEventListener("beforeinstallprompt", event => {
      event.preventDefault();
      deferredInstallPrompt = event;
      els.installAppBtn.hidden = false;
    });

    els.installAppBtn.addEventListener("click", async () => {
      if (!deferredInstallPrompt) {
        showToast("Utilisez le menu du navigateur puis « Installer l’application ».");
        return;
      }

      deferredInstallPrompt.prompt();
      await deferredInstallPrompt.userChoice;
      deferredInstallPrompt = null;
      els.installAppBtn.hidden = true;
    });

    window.addEventListener("appinstalled", () => {
      deferredInstallPrompt = null;
      els.installAppBtn.hidden = true;
      showToast("Okane Flow est installée.");
    });

    const updateOnlineStatus = () => {
      const existing = document.getElementById("offlineIndicator");
      if (navigator.onLine) {
        existing?.remove();
        return;
      }

      if (!existing) {
        const indicator = document.createElement("div");
        indicator.id = "offlineIndicator";
        indicator.className = "offline-indicator";
        indicator.textContent = "Mode hors ligne";
        document.body.appendChild(indicator);
      }
    };

    window.addEventListener("online", updateOnlineStatus);
    window.addEventListener("offline", updateOnlineStatus);
    updateOnlineStatus();
  }

  function cacheElements() {
    [
      "sidebar", "sidebarToggle", "pageEyebrow", "pageTitle", "openEventModalBtn", "installAppBtn",
      "loadDemoBtn", "forecastRange", "forecastEndLabel", "projectedBalanceHero",
      "heroStatusText", "openingBalanceMetric", "incomeMetric", "expenseMetric",
      "endingBalanceMetric", "endingBalanceHint", "cashflowChart", "chartEmptyState",
      "riskLevelBadge", "riskSummary", "riskDetails", "upcomingEvents",
      "categoryBreakdown", "searchInput", "typeFilter", "statusFilter",
      "eventsTableBody", "eventCountBadge", "tableEmptyState", "calendarMonthLabel",
      "calendarGrid", "prevMonthBtn", "nextMonthBtn", "todayBtn", "settingsForm",
      "openingBalanceInput", "alertThresholdInput", "currencyInput", "currencySuffix",
      "exportBtn", "importInput", "clearDataBtn",
      "feasibilityForm", "loadFeasibilityDemoBtn", "projectNameInput", "projectProfileInput",
      "desiredStartDateInput", "projectCostsList", "addProjectCostBtn", "workingCapitalInput",
      "contingencyRateInput", "projectFundingList", "addProjectFundingBtn", "monthlyIncomeInput",
      "monthlyExpensesInput", "manualMonthlySavingsInput", "currentSavingsInput",
      "projectMonthlyRevenueInput", "projectMonthlyOperatingCostsInput", "resetFeasibilityBtn",
      "feasibilityStatus", "totalProjectNeedResult", "immediateResourcesResult", "fundingGapResult",
      "monthlySavingsResult", "monthsToTargetResult", "targetDateHint", "paybackResult",
      "feasibilityAnalysis", "projectCostBreakdown",
      "eventModal", "eventModalTitle",
      "closeEventModalBtn", "cancelEventBtn", "eventForm", "eventIdInput",
      "eventNameInput", "eventAmountInput", "eventDateInput", "eventCategoryInput",
      "eventStatusInput", "eventRecurrenceInput", "eventEndDateInput",
      "eventNotesInput", "toastContainer"
    ].forEach(id => {
      els[id] = document.getElementById(id);
    });

    els.navItems = Array.from(document.querySelectorAll(".nav-item"));
    els.views = Array.from(document.querySelectorAll(".view"));
    els.switchViewButtons = Array.from(document.querySelectorAll("[data-switch-view]"));
  }

  function bindEvents() {
    els.navItems.forEach(btn => btn.addEventListener("click", () => switchView(btn.dataset.view)));
    els.switchViewButtons.forEach(btn => btn.addEventListener("click", () => switchView(btn.dataset.switchView)));

    els.sidebarToggle.addEventListener("click", () => els.sidebar.classList.toggle("open"));
    els.openEventModalBtn.addEventListener("click", () => openEventModal());
    els.closeEventModalBtn.addEventListener("click", closeEventModal);
    els.cancelEventBtn.addEventListener("click", closeEventModal);
    els.eventModal.addEventListener("click", e => {
      if (e.target === els.eventModal) closeEventModal();
    });

    document.querySelectorAll('input[name="eventType"]').forEach(input => {
      input.addEventListener("change", () => populateCategoryOptions(input.value));
    });

    els.eventForm.addEventListener("submit", saveEvent);
    els.forecastRange.addEventListener("change", () => {
      state.settings.forecastDays = Number(els.forecastRange.value);
      persist();
      renderAll();
    });

    [els.searchInput, els.typeFilter, els.statusFilter].forEach(el => {
      el.addEventListener("input", renderEventsTable);
      el.addEventListener("change", renderEventsTable);
    });

    els.settingsForm.addEventListener("submit", saveSettings);
    els.loadDemoBtn.addEventListener("click", loadDemoData);
    els.exportBtn.addEventListener("click", exportData);
    els.importInput.addEventListener("change", importData);
    els.clearDataBtn.addEventListener("click", clearData);

    els.feasibilityForm.addEventListener("submit", e => {
      e.preventDefault();
      saveFeasibilityInputs();
      renderFeasibility();
      showToast("Étude de faisabilité mise à jour.");
    });
    els.addProjectCostBtn.addEventListener("click", () => addCostRow());
    els.addProjectFundingBtn.addEventListener("click", () => addFundingRow());
    els.loadFeasibilityDemoBtn.addEventListener("click", loadFeasibilityDemo);
    els.resetFeasibilityBtn.addEventListener("click", resetFeasibility);
    els.feasibilityForm.addEventListener("input", () => {
      saveFeasibilityInputs(false);
      renderFeasibility();
    });
    els.feasibilityForm.addEventListener("change", () => {
      saveFeasibilityInputs(false);
      renderFeasibility();
    });

    els.prevMonthBtn.addEventListener("click", () => {
      currentCalendarDate = addMonths(currentCalendarDate, -1);
      renderCalendar();
    });

    els.nextMonthBtn.addEventListener("click", () => {
      currentCalendarDate = addMonths(currentCalendarDate, 1);
      renderCalendar();
    });

    els.todayBtn.addEventListener("click", () => {
      currentCalendarDate = startOfMonth(new Date());
      renderCalendar();
    });

    document.addEventListener("keydown", e => {
      if (e.key === "Escape" && els.eventModal.classList.contains("open")) closeEventModal();
    });
  }

  function loadState() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return structuredClone(defaultState);
      const parsed = JSON.parse(raw);
      return sanitizeState(parsed);
    } catch {
      return structuredClone(defaultState);
    }
  }

  function sanitizeState(data) {
    return {
      settings: {
        openingBalance: finiteNumber(data?.settings?.openingBalance, defaultState.settings.openingBalance),
        alertThreshold: finiteNumber(data?.settings?.alertThreshold, defaultState.settings.alertThreshold),
        currency: ["MGA", "EUR", "USD"].includes(data?.settings?.currency) ? data.settings.currency : "MGA",
        forecastDays: [30, 60, 90, 180, 365].includes(Number(data?.settings?.forecastDays))
          ? Number(data.settings.forecastDays)
          : 90
      },
      events: Array.isArray(data?.events)
        ? data.events.map(sanitizeEvent).filter(Boolean)
        : [],
      feasibility: sanitizeFeasibility(data?.feasibility)
    };
  }


  function sanitizeFeasibility(value) {
    const source = value || defaultState.feasibility;
    const cleanRows = (rows, kind) => Array.isArray(rows) && rows.length
      ? rows.map(row => ({
          id: String(row?.id || generateId()),
          name: String(row?.name || "").slice(0, 90),
          category: kind === "cost" ? String(row?.category || "Autre") : undefined,
          timing: kind === "cost" ? String(row?.timing || "Démarrage") : undefined,
          type: kind === "funding" ? String(row?.type || "Autre") : undefined,
          amount: Math.max(0, finiteNumber(row?.amount, 0))
        }))
      : structuredClone(kind === "cost" ? defaultState.feasibility.costs : defaultState.feasibility.funding);

    return {
      projectName: String(source.projectName || "").slice(0, 90),
      profile: ["personal", "business", "association"].includes(source.profile) ? source.profile : "personal",
      desiredStartDate: source.desiredStartDate && isValidDateString(source.desiredStartDate) ? source.desiredStartDate : "",
      costs: cleanRows(source.costs, "cost"),
      funding: cleanRows(source.funding, "funding"),
      workingCapital: Math.max(0, finiteNumber(source.workingCapital, 0)),
      contingencyRate: Math.min(100, Math.max(0, finiteNumber(source.contingencyRate, 10))),
      monthlyIncome: Math.max(0, finiteNumber(source.monthlyIncome, 0)),
      monthlyExpenses: Math.max(0, finiteNumber(source.monthlyExpenses, 0)),
      manualMonthlySavings: Math.max(0, finiteNumber(source.manualMonthlySavings, 0)),
      currentSavings: Math.max(0, finiteNumber(source.currentSavings, 0)),
      projectMonthlyRevenue: Math.max(0, finiteNumber(source.projectMonthlyRevenue, 0)),
      projectMonthlyOperatingCosts: Math.max(0, finiteNumber(source.projectMonthlyOperatingCosts, 0))
    };
  }

  function sanitizeEvent(event) {
    if (!event || !event.id || !event.name || !event.date) return null;
    const amount = Math.abs(finiteNumber(event.amount, 0));
    if (amount <= 0) return null;

    return {
      id: String(event.id),
      name: String(event.name).slice(0, 80),
      type: event.type === "expense" ? "expense" : "income",
      amount,
      date: isValidDateString(event.date) ? event.date : toISODate(new Date()),
      endDate: event.endDate && isValidDateString(event.endDate) ? event.endDate : "",
      category: String(event.category || "Autres"),
      status: ["planned", "confirmed", "paid"].includes(event.status) ? event.status : "planned",
      recurrence: ["none", "weekly", "monthly", "quarterly", "yearly"].includes(event.recurrence)
        ? event.recurrence
        : "none",
      notes: String(event.notes || "").slice(0, 250),
      createdAt: event.createdAt || new Date().toISOString()
    };
  }

  function persist() {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
  }

  function renderAll() {
    els.forecastRange.value = String(state.settings.forecastDays);
    syncSettingsForm();
    renderDashboard();
    renderEventsTable();
    renderCalendar();
    renderFeasibilityForm();
    renderFeasibility();
  }

  function renderDashboard() {
    const projection = buildProjection(state.settings.forecastDays);
    const summary = summarizeProjection(projection);

    els.openingBalanceMetric.textContent = formatMoney(state.settings.openingBalance);
    els.incomeMetric.textContent = formatMoney(summary.totalIncome);
    els.expenseMetric.textContent = formatMoney(summary.totalExpense);
    els.endingBalanceMetric.textContent = formatMoney(summary.endingBalance);
    els.projectedBalanceHero.textContent = formatMoney(summary.endingBalance);
    els.forecastEndLabel.textContent = formatDate(summary.endDate);
    els.endingBalanceHint.textContent = `${projection.length} jours simulés`;

    if (!state.events.length) {
      els.heroStatusText.textContent = "Ajoutez vos premiers événements pour commencer la simulation.";
    } else if (summary.firstNegativeDate) {
      els.heroStatusText.textContent = `Risque de découvert à partir du ${formatDate(summary.firstNegativeDate)}.`;
    } else if (summary.minimumBalance < state.settings.alertThreshold) {
      els.heroStatusText.textContent = "La trésorerie reste positive mais franchit votre seuil d’alerte.";
    } else {
      els.heroStatusText.textContent = "La trésorerie prévisionnelle reste au-dessus du seuil d’alerte.";
    }

    renderChart(projection);
    renderRisk(summary);
    renderUpcomingEvents();
    renderCategoryBreakdown();
  }

  function buildProjection(days) {
    const start = startOfDay(new Date());
    const end = addDays(start, days - 1);
    const occurrences = expandOccurrences(start, end);
    const byDate = new Map();

    occurrences.forEach(occ => {
      const key = toISODate(occ.date);
      if (!byDate.has(key)) byDate.set(key, []);
      byDate.get(key).push(occ);
    });

    let balance = state.settings.openingBalance;
    const rows = [];

    for (let i = 0; i < days; i++) {
      const date = addDays(start, i);
      const key = toISODate(date);
      const dayEvents = byDate.get(key) || [];
      let income = 0;
      let expense = 0;

      dayEvents.forEach(occ => {
        if (occ.type === "income") income += occ.amount;
        else expense += occ.amount;
      });

      balance += income - expense;
      rows.push({ date, balance, income, expense, events: dayEvents });
    }

    return rows;
  }

  function summarizeProjection(projection) {
    const totalIncome = projection.reduce((sum, row) => sum + row.income, 0);
    const totalExpense = projection.reduce((sum, row) => sum + row.expense, 0);
    const endingBalance = projection.length ? projection[projection.length - 1].balance : state.settings.openingBalance;
    const minimumRow = projection.reduce((min, row) => row.balance < min.balance ? row : min, projection[0] || {
      balance: state.settings.openingBalance,
      date: new Date()
    });
    const firstNegative = projection.find(row => row.balance < 0);
    const firstBelowThreshold = projection.find(row => row.balance < state.settings.alertThreshold);

    return {
      totalIncome,
      totalExpense,
      endingBalance,
      minimumBalance: minimumRow.balance,
      minimumBalanceDate: minimumRow.date,
      firstNegativeDate: firstNegative?.date || null,
      firstBelowThresholdDate: firstBelowThreshold?.date || null,
      endDate: projection[projection.length - 1]?.date || new Date()
    };
  }

  function expandOccurrences(rangeStart, rangeEnd) {
    const occurrences = [];

    state.events.forEach(event => {
      const start = parseISODate(event.date);
      const eventEnd = event.endDate ? parseISODate(event.endDate) : rangeEnd;

      if (event.recurrence === "none") {
        if (start >= rangeStart && start <= rangeEnd) {
          occurrences.push({ ...event, date: start });
        }
        return;
      }

      let cursor = new Date(start);
      let guard = 0;

      while (cursor <= rangeEnd && cursor <= eventEnd && guard < 1000) {
        if (cursor >= rangeStart) occurrences.push({ ...event, date: new Date(cursor) });
        cursor = nextOccurrence(cursor, event.recurrence);
        guard++;
      }
    });

    return occurrences.sort((a, b) => a.date - b.date);
  }

  function nextOccurrence(date, recurrence) {
    switch (recurrence) {
      case "weekly": return addDays(date, 7);
      case "monthly": return addMonthsPreserveDay(date, 1);
      case "quarterly": return addMonthsPreserveDay(date, 3);
      case "yearly": return addYearsPreserveDay(date, 1);
      default: return new Date(date);
    }
  }

  function renderChart(projection) {
    const hasData = state.events.length > 0;
    els.chartEmptyState.classList.toggle("show", !hasData);
    els.cashflowChart.style.display = hasData ? "block" : "none";

    if (!hasData || typeof Chart === "undefined") {
      if (chart) {
        chart.destroy();
        chart = null;
      }
      return;
    }

    const labels = projection.map(row => new Intl.DateTimeFormat("fr-FR", {
      day: "2-digit",
      month: "short"
    }).format(row.date));

    const values = projection.map(row => row.balance);

    if (chart) chart.destroy();

    chart = new Chart(els.cashflowChart, {
      type: "line",
      data: {
        labels,
        datasets: [{
          label: "Solde",
          data: values,
          borderWidth: 2.5,
          tension: 0.25,
          pointRadius: 0,
          pointHoverRadius: 4,
          fill: true,
          borderColor: "#1d5b4f",
          backgroundColor: context => {
            const { chart } = context;
            const { ctx, chartArea } = chart;
            if (!chartArea) return "rgba(29, 91, 79, 0.08)";
            const gradient = ctx.createLinearGradient(0, chartArea.top, 0, chartArea.bottom);
            gradient.addColorStop(0, "rgba(29, 91, 79, 0.18)");
            gradient.addColorStop(1, "rgba(29, 91, 79, 0.01)");
            return gradient;
          },
          segment: {
            borderColor: ctx => (ctx.p0.parsed.y < 0 || ctx.p1.parsed.y < 0) ? "#c84747" : "#1d5b4f"
          }
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        interaction: {
          intersect: false,
          mode: "index"
        },
        plugins: {
          legend: { display: false },
          tooltip: {
            callbacks: {
              label: context => ` ${formatMoney(context.parsed.y)}`
            }
          }
        },
        scales: {
          x: {
            grid: { display: false },
            ticks: {
              maxTicksLimit: 9,
              color: "#76818b"
            }
          },
          y: {
            grid: { color: "#edf0f2" },
            ticks: {
              color: "#76818b",
              callback: value => compactMoney(value)
            }
          }
        }
      }
    });
  }

  function renderRisk(summary) {
    let level = "safe";
    let label = "Faible";
    let icon = "✓";
    let title = "Trésorerie maîtrisée";
    let text = "Aucun découvert n’est détecté sur la période simulée.";

    if (summary.firstNegativeDate) {
      level = "danger";
      label = "Élevé";
      icon = "!";
      title = "Découvert prévisionnel";
      text = `Le solde devient négatif le ${formatDate(summary.firstNegativeDate)}.`;
    } else if (summary.minimumBalance < state.settings.alertThreshold) {
      level = "warning";
      label = "Modéré";
      icon = "!";
      title = "Seuil d’alerte franchi";
      text = `Le solde passe sous ${formatMoney(state.settings.alertThreshold)}.`;
    }

